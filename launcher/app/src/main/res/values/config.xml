<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration (Fire TV Stick 4K, AFTKM). Edit this file, then rebuild and install.
  Package names: on the TV run `pm list packages`.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.xiaodianshi.tv.yst</item>      <!-- Bilibili -->
        <item>com.amazon.firetv.youtube</item>   <!-- YouTube -->
        <item>com.ugreen.nasprotv</item>         <!-- UGREEN NAS -->
        <item>com.phlox.tvwebbrowser</item>      <!-- TV Bro browser -->
        <item>io.github.jqssun.airplay</item>    <!-- AirPlay receiver (open source): screen cast from iPhone, iPad -->
    </string-array>

    <!-- Apps never shown as tiles. Fire Stick has no HDMI/tuner inputs, so the Inputs tile is hidden. -->
    <string-array name="hidden_apps">
        <item>com.gathin.tvhome.inputs</item>
        <item>com.amazon.firetv.troubleshooting</item>
        <item>com.amazon.spiderpork</item>
        <item>com.amazon.whasettings</item>
    </string-array>

    <!-- No Live TV / tuner app on a Fire Stick. -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">5</integer>

    <!-- Purple/colour/media remote buttons open Stremio (only when Stremio is installed).
         Needs the launcher's accessibility service enabled. -->
    <bool name="remap_media_keys_to_stremio">true</bool>

    <!-- Fire TV only: bring this launcher back whenever Amazon's home screen appears, since Fire OS
         can't change the default home. Ignored on TVs without Amazon's launcher. See docs/fire-tv.md. -->
    <bool name="firetv_home_override">true</bool>

    <!-- Amazon's Developer Options screen, opened by Settings > Device > ADB debugging when the launcher
         may not switch ADB itself (WRITE_SECURE_SETTINGS not granted). Empty: the standard settings action. -->
    <string name="developer_options_component" translatable="false"></string>
</resources>
