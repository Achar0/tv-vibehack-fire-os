<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration (Fire TV Stick 4K, AFTKM). Edit this file, then rebuild and install.
  Package names: on the TV run `pm list packages`.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.xiaodianshi.tv.yst</item>      <!-- Bilibili -->
        <item>com.amazon.firetv.youtube</item>   <!-- YouTube -->
        <item>com.ugreen.nasprotv</item>         <!-- UGREEN NAS -->
        <item>com.phlox.tvwebbrowser</item>      <!-- TV Bro browser -->
        <item>io.github.jqssun.airplay</item>    <!-- AirPlay receiver (open source): screen cast from iPhone, iPad -->
    </string-array>

    <!-- Shortcut tiles: "Label|address|app package|optional type". The address opens straight in that app; the tile
         uses the app's icon and is skipped when the app isn't installed. Put "shortcut.<label in lower case, spaces as
         dashes>" in dock_apps or hidden_apps to dock or hide one (e.g. shortcut.news). App "channels" opens the
         address as an IPTV playlist in the launcher's channel picker (played in iptv_player). -->
    <!-- Top shelf: the focused app's name in large type above the dock, as on tvOS. -->
    <bool name="show_top_shelf">true</bool>

    <!-- Remote keys that open the IPTV channel picker (the first "channels" shortcut): KEYCODE_TV (170), the Live
         button, and KEYCODE_GUIDE (172). Checked before remap_media_keys_to_stremio. Empty to leave them to Fire OS. -->
    <integer-array name="tv_button_keys">
        <item>170</item>
        <item>172</item>
    </integer-array>

    <!-- Player app for the IPTV channel picker (shortcut app "channels"). -->
    <string name="iptv_player" translatable="false">org.videolan.vlc</string>

    <string-array name="shortcuts" translatable="false">
        <!-- Examples (personal ones can go in launcher/app/src/release/res/values/, which git ignores):
        <item>News|https://example.org/live|com.phlox.tvwebbrowser</item>
        <item>TV|https://example.org/playlist.m3u8|channels</item> -->
    </string-array>

    <!-- Apps never shown as tiles. Fire Stick has no HDMI/tuner inputs, so the Inputs tile is hidden. -->
    <string-array name="hidden_apps">
        <item>com.gathin.tvhome.inputs</item>
        <item>com.amazon.firetv.troubleshooting</item>
        <item>com.amazon.spiderpork</item>
        <item>com.amazon.whasettings</item>
    </string-array>

    <!-- No Live TV / tuner app on a Fire Stick. -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">5</integer>

    <!-- Purple/colour/media remote buttons open Stremio (only when Stremio is installed).
         Needs the launcher's accessibility service enabled. -->
    <bool name="remap_media_keys_to_stremio">true</bool>

    <!-- Fire TV only: bring this launcher back whenever Amazon's home screen appears, since Fire OS
         can't change the default home. Ignored on TVs without Amazon's launcher. See docs/fire-tv.md. -->
    <bool name="firetv_home_override">true</bool>

    <!-- Amazon's Developer Options screen, opened by Settings > Device > ADB debugging when the launcher
         may not switch ADB itself (WRITE_SECURE_SETTINGS not granted). Empty: the standard settings action. -->
    <string name="developer_options_component" translatable="false">com.amazon.tv.settings.v2/.tv.device.DeviceActivity</string>
    <!-- Scheduled wake: at this time the TV turns on and opens the NAS page. wake_hour -1 turns it off.
         wake_days are java.util.Calendar days (Sunday = 1). Personal values go in launcher/app/src/release/res/values/. -->
    <integer name="wake_hour">-1</integer>
    <integer name="wake_minute">0</integer>
    <integer-array name="wake_days" />

</resources>
