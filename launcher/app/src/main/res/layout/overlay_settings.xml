<?xml version="1.0" encoding="utf-8"?>
<!-- Two-pane Settings, inflated from settingsStub on first open (SettingsPanel). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EB080A0E"
    android:clickable="true"
    android:paddingStart="64dp"
    android:paddingEnd="64dp"
    android:paddingTop="40dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.02"
            android:text="@string/settings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/outfit"
            android:text="@string/settings_back_hint"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.32"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/catDevice"
                    style="@style/SettingsCategory"
                    android:nextFocusUp="@id/catDevice"
                    android:text="@string/settings_cat_device" />

                <TextView
                    android:id="@+id/catAppearance"
                    style="@style/SettingsCategory"
                    android:text="@string/settings_cat_appearance" />

                <TextView
                    android:id="@+id/catAbout"
                    style="@style/SettingsCategory"
                    android:nextFocusDown="@id/catAbout"
                    android:text="@string/settings_cat_about" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.68"
                android:layout_marginStart="28dp">

                <LinearLayout
                    android:id="@+id/paneDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAdb"
                        style="@style/SettingsRow"
                        android:nextFocusUp="@id/rowAdb"
                        android:nextFocusLeft="@id/catDevice"
                        android:nextFocusRight="@id/rowAdb">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_adb" />

                        <TextView
                            android:id="@+id/adbState"
                            style="@style/SettingsRowValue"
                            android:alpha="1"
                            android:fontVariationSettings="'wght' 600" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowFireSettings"
                        style="@style/SettingsRow"
                        android:nextFocusLeft="@id/catDevice"
                        android:nextFocusRight="@id/rowFireSettings">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_fire" />

                        <TextView
                            style="@style/SettingsRowValue"
                            android:text="›" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowWifi"
                        style="@style/SettingsRow"
                        android:nextFocusDown="@id/rowWifi"
                        android:nextFocusLeft="@id/catDevice"
                        android:nextFocusRight="@id/rowWifi">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_wifi" />

                        <TextView
                            style="@style/SettingsRowValue"
                            android:text="›" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paneAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/rowWallpaper"
                        style="@style/SettingsRow"
                        android:nextFocusUp="@id/rowWallpaper"
                        android:nextFocusLeft="@id/catAppearance"
                        android:nextFocusRight="@id/rowWallpaper">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_wallpaper" />

                        <TextView
                            android:id="@+id/valWallpaper"
                            style="@style/SettingsRowValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDock"
                        style="@style/SettingsRow"
                        android:nextFocusLeft="@id/catAppearance"
                        android:nextFocusRight="@id/rowDock">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_peek" />

                        <TextView
                            android:id="@+id/valDock"
                            style="@style/SettingsRowValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowTopBar"
                        style="@style/SettingsRow"
                        android:nextFocusDown="@id/rowTopBar"
                        android:nextFocusLeft="@id/catAppearance"
                        android:nextFocusRight="@id/rowTopBar">

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="@string/settings_top_bar" />

                        <TextView
                            android:id="@+id/valTopBar"
                            style="@style/SettingsRowValue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_appearance_hint"
                        android:textColor="#66FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paneAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/aboutVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/settings_about_desc"
                        android:textColor="#80FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
